# Copy to .env and fill in the real values.
# .env is git-ignored. Never commit real secrets.

# ── WAHA (the WhatsApp HTTP API container we wrap) ──────────────────────────
# WAHA_BASE_URL: how the MCP container reaches WAHA. Use the docker network
# alias if both containers are on the same network (default), or http://host
# IP/3000 otherwise. See docker-compose.yml for the network config.
WAHA_BASE_URL=http://waha:3000

# Session name as configured in WAHA — usually "default" unless you renamed it.
WAHA_SESSION=default

# The X-Api-Key WAHA expects. Get/generate it on the WAHA side; here we just
# pass it through. Generate with: openssl rand -hex 24
WAHA_API_KEY=REPLACE_WITH_YOUR_WAHA_API_KEY

# ── MCP server ──────────────────────────────────────────────────────────────
# The shared secret that protects this MCP endpoint. It is embedded in the
# public URL as /<MCP_API_KEY>/mcp because Claude.ai's "Custom connector"
# UI does not have a Bearer-token field. Treat it like a password.
# Generate with: openssl rand -hex 32
MCP_API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ── Domain (used by FastMCP's DNS-rebinding protection) ─────────────────────
# Hostnames the MCP server will accept in the Host header. Add yours here.
# Comma-separated. localhost/127.0.0.1 are always useful for debugging.
MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1
